+                              ("envelope_id", envelope_id))
+               if not isinstance(v, str) or not v.strip()]
+    if missing:
+        raise SpendAuthorizationRequired(
+            entry_point, f"input governati mancanti: {', '.join(missing)}")
+    if envelope_units is not None:
+        raise SpendAuthorizationRequired(
+            entry_point, "envelope_units (budget scelto dal client) non e' ammesso per un "
+                         "adapter spendibile: l'importo viene dalla quote fidata")
+
+
+def authorize_dispatch(store, job_id: str, *, adapter_name: str, adapter_account: str,
+                       spec_key: str, payload_digest: str, attempt_token: str,
+                       entry_point: str = "authorize_dispatch") -> DispatchAuthorization:
+    """CLAIMA il diritto a dispacciare questo tentativo, sul journal autorevole.
+
+    HUMAN REVIEW 02 — SAME_ATTEMPT_AUTHORIZATION_REISSUABLE. Prima questa funzione
+    LEGGEVA il journal e coniava un oggetto. La lettura era corretta, ma non consumava
+    nulla: finche' la riga restava `RESERVED`, due chiamate producevano due
+    autorizzazioni distinte, entrambe valide. Chiuso il replay dello stesso oggetto,
+    restava la riemissione dello stesso tentativo.
+
+    Ora la decisione non e' piu' una lettura: e'
+    `store.claim_dispatch_authorization(...)`, che in UNA transazione verifica e
+    CLAIMA, con `job_id` come PRIMARY KEY. Un secondo claim dello stesso tentativo e'
+    `DISPATCH_AUTHORIZATION_ALREADY_CLAIMED` — fra chiamate, fra thread e fra processi,
+    perche' l'autorita' e' il file del journal, non la memoria di un interprete.
+
+    Tutte le verifiche (pre-submit, ownership, digest, attempt_token, quote consumata
+    da QUESTO job, envelope, movimento RESERVE) vivono DENTRO quella transazione: qui
+    non sono duplicate, perche' due copie della stessa regola sono due regole che prima
+    o poi divergono.
+
+    Questa funzione e' l'UNICO posto in cui una `DispatchAuthorization` puo' nascere:
+    possiede il token di conio e registra l'oggetto nel registro dei coniati."""
+    claim = getattr(store, "claim_dispatch_authorization", None)
+    if not callable(claim):
+        raise SpendAuthorizationInvalid(
+            "DISPATCH_CLAIM_AUTHORITY_MISSING",
+            f"{entry_point}: lo store non espone `claim_dispatch_authorization`, quindi non "
+            f"puo' garantire che un tentativo autorizzi UN solo dispatch. Fail-closed: senza "
+            f"quella garanzia non esiste autorizzazione.")
+    facts = claim(job_id, attempt_token=attempt_token, payload_digest=payload_digest,
+                  spec_key=spec_key, provider=adapter_name, provider_account=adapter_account or "")
+    return _register_minted(DispatchAuthorization(
+        job_id=facts["job_id"], spec_key=facts["spec_key"],
+        operation_id=facts["operation_id"], attempt_token=facts["attempt_token"],
+        payload_digest=facts["payload_digest"], provider=facts["provider"],
+        provider_account=facts["provider_account"], envelope_id=facts["envelope_id"],
+        quote_id=facts["quote_id"], quote_amount=int(facts["quote_amount"]),
+        quote_unit=str(facts["quote_unit"]), mint=_MINT))
+
+
+class _DispatchGrant:
+    """Concessione a tempo determinato: vive quanto il `with`, e non oltre.
+
+    Non e' rientrante, non e' ereditabile da un altro thread e non e' riusabile:
+    all'uscita l'autorizzazione e' CONSUMATA e nessun varco la accetta piu'."""
+
+    def __init__(self, adapter, auth: DispatchAuthorization):
+        self._adapter = adapter
+        self._auth = _require_minted(auth, "grant_dispatch")
+
+    def __enter__(self):
+        _require_minted(self._auth, "grant_dispatch")
+        slot = _grant_slot(self._adapter)
+        if getattr(slot, "auth", None) is not None:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_GRANT_REENTRANT",
+                f"l'adapter {getattr(self._adapter, 'name', '?')!r} ha gia' una concessione "
+                f"attiva in questo thread: un tentativo per volta")
+        slot.auth = self._auth
+        return self._auth
+
+    def __exit__(self, *exc):
+        _grant_slot(self._adapter).auth = None
+        _mark_spent(self._auth)
+        return False
+
+
+_GRANT_LOCK = threading.Lock()
+
+
+def _grant_slot(adapter):
+    """Slot THREAD-LOCAL per istanza di adapter: `Batch.go` dispaccia job in
+    thread paralleli con lo STESSO adapter, e una concessione non deve mai
+    attraversare quel confine."""
+    slot = adapter.__dict__.get("_dispatch_grant_slot")
+    if slot is None:
+        with _GRANT_LOCK:
+            slot = adapter.__dict__.get("_dispatch_grant_slot")
+            if slot is None:
+                slot = threading.local()
+                adapter.__dict__["_dispatch_grant_slot"] = slot
+    return slot
+
+
+def grant_dispatch(adapter, store, job_id: str, *, spec_key: str, payload_digest: str,
+                   attempt_token: str, entry_point: str = "grant_dispatch") -> _DispatchGrant:
+    """UNICO modo supportato di autorizzare `authorize_payload` + `submit` di uno spender.
+
+    HUMAN REVIEW 01: non riceve piu' un'autorizzazione gia' costruita. Riceve lo
+    STORE AUTOREVOLE e l'identita' del tentativo, e rilegge il journal QUI, adesso.
+    Non esiste una firma alternativa che accetti una capability presentata dal
+    chiamante: se esistesse, sarebbe quella che verrebbe usata."""
+    auth = authorize_dispatch(
+        store, job_id, adapter_name=getattr(adapter, "name", ""),
+        adapter_account=str(getattr(adapter, "account_id", "") or ""),
+        spec_key=spec_key, payload_digest=payload_digest, attempt_token=attempt_token,
+        entry_point=entry_point)
+    return _DispatchGrant(adapter, auth)
+
+
+def _active_grant(adapter):
+    return getattr(_grant_slot(adapter), "auth", None)
+
+
+def _guard_hook(name: str, fn):
+    """Avvolge un hook di implementazione (`_dispatch`, `_authorize_payload`) con la
+    stessa verifica dei template method.
+
+    PERCHE'. In Python il trattino basso non nasconde nulla: `adapter._dispatch(spec,
+    auth)` e' una chiamata come le altre, e senza questo guard sarebbe il varco
+    lasciato aperto dietro la struttura. Il guard e' applicato dalla BASE in
+    `__init_subclass__`: la sottoclasse non deve ricordarsi di nulla, e non puo'
+    disapplicarlo se non ridefinendo l'hook — che verrebbe a sua volta avvolto."""
+    @functools.wraps(fn)
+    def guarded(self, *args, **kwargs):
+        entry = f"{type(self).__qualname__}.{name}"
+        active = _require_minted(_active_grant(self), entry)
+        presented = args[1] if len(args) > 1 else kwargs.get("auth")
+        if presented is not None and presented is not active:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_AUTHORIZATION_NOT_ACTIVE",
+                f"{entry}: l'autorizzazione presentata non e' quella concessa in questo thread")
+        return fn(self, *args, **kwargs)
+    guarded.__lspc_guarded__ = True
+    return guarded
+
+
+class SpendCapableAdapter:
+    """Base OBBLIGATORIA per ogni adapter che puo' raggiungere un provider reale.
+
+    Un adapter reale (Higgsfield, o chiunque altro) deriva da qui e implementa
+    `_dispatch(spec, auth)` e `_authorize_payload(digest, auth)`. Non implementa
+    `submit` ne' `authorize_payload`: quei due nomi sono il confine, e
+    `__init_subclass__` rifiuta a tempo di definizione della classe qualunque
+    sottoclasse che provi a ridefinirli o a ereditarli da un'altra base. Non e'
+    una convenzione da ricordare: e' un TypeError.
+
+    HUMAN REVIEW 01: `__init_subclass__` AVVOLGE anche i due hook di
+    implementazione con lo stesso guard dei template method. Una chiamata diretta
+    a `_dispatch` o `_authorize_payload` non raggiunge il provider."""
+
+    spend_capable = True
+
+    def __init_subclass__(cls, **kwargs):
+        super().__init_subclass__(**kwargs)
+        for name in ("submit", "authorize_payload"):
+            if name in cls.__dict__:
+                raise TypeError(
+                    f"{cls.__qualname__}: `{name}` e' il confine dello spender e non si "
+                    f"sovrascrive; implementare `_dispatch` / `_authorize_payload`")
+            if getattr(cls, name, None) is not getattr(SpendCapableAdapter, name):
+                raise TypeError(
+                    f"{cls.__qualname__}: `{name}` risolve a un'altra implementazione "
+                    f"(ordine di risoluzione: {[b.__name__ for b in cls.__mro__]}); "
+                    f"SpendCapableAdapter deve precedere le altre basi")
+        for name in ("_dispatch", "_authorize_payload"):
+            fn = cls.__dict__.get(name)
+            if fn is not None and callable(fn) and not getattr(fn, "__lspc_guarded__", False):
+                setattr(cls, name, _guard_hook(name, fn))
+
+    # -------------------------------------------------------- confine
+    def _require_dispatch(self, spec, entry_point: str) -> DispatchAuthorization:
+        entry = f"{type(self).__qualname__}.{entry_point}"
+        auth = _require_minted(_active_grant(self), entry)
+        if not auth.covers(spec):
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_SPEC_NOT_COVERED",
+                f"{entry}: la concessione copre la spec {auth.spec_key[:12]}…, non quella presentata")
+        if getattr(self, "name", None) != auth.provider:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_PROVIDER_NOT_COVERED",
+                f"concessione emessa per {auth.provider!r}, adapter {getattr(self, 'name', None)!r}")
+        return auth
+
+    def authorize_payload(self, digest: str) -> None:
+        auth = self._require_dispatch_digest(digest)
+        return self._authorize_payload(digest, auth)
+
+    def _require_dispatch_digest(self, digest: str) -> DispatchAuthorization:
+        entry = f"{type(self).__qualname__}.authorize_payload"
+        auth = _require_minted(_active_grant(self), entry)
+        if digest != auth.payload_digest:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_DIGEST_NOT_COVERED",
+                f"{entry}: la concessione copre il digest {auth.payload_digest[:16]}…, "
+                f"non {str(digest)[:16]}…")
+        return auth
+
+    def submit(self, spec: "GenSpec") -> "Job":
+        auth = self._require_dispatch(spec, "submit")
+        return self._dispatch(spec, auth)
+
+    # -------------------------------------------------- da implementare
+    def _authorize_payload(self, digest: str, auth: DispatchAuthorization) -> None:
+        raise NotImplementedError
+
+    def _dispatch(self, spec: "GenSpec", auth: DispatchAuthorization) -> "Job":
+        raise NotImplementedError
