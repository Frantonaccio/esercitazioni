+    ps = [CTX.Process(target=_proc_entry, args=(q, claim_in_process, args, {"barrier": barrier}))
+          for _ in range(2)]
+    for p_ in ps:
+        p_.start()
+    outs = [q.get(timeout=120) for _ in ps]
+    for p_ in ps:
+        p_.join(30)
+    pids = {o.get("pid") for o in outs if o.get("pid")}
+    claimed = [o for o in outs if o.get("claimed")]
+    refused = [o for o in outs if not o.get("claimed")]
+    if len(pids) < 2:
+        raise AssertionError(f"BLOCKED_ENVIRONMENT: due processi distinti non osservati ({outs})")
