+                ("q", "Q. stesso attempt, due thread concorrenti", q_same_attempt_two_threads),
+                ("r", "R. stesso attempt, due PROCESSI concorrenti", r_same_attempt_two_processes)):
+            check(name, lambda fn=fn, key=key: fn(os.path.join(tmp, f"{key}.db")))
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+    ok = 0
+    for name, passed, detail in RESULTS:
+        mark = f"{GREEN}PASS{RESET}" if passed else f"{RED}FAIL{RESET}"
