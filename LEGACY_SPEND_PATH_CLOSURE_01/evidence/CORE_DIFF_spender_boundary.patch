+# ------------------------------------------------------------------- P
+def p_same_attempt_two_sequential_claims(db: str) -> str:
+    """La sequenza esatta chiesta dalla Human Review 02: creare g1, USARLO, uscire,
+    NON chiamare `mark_submitted`, e provare a ottenere g2 per lo stesso attempt.
+
+    Niente oggetti falsi, niente store duck-typed: store reale, prenotazione governata
+    reale, quote LAB reale, ledger `RESERVE` reale, stesso `job_id`, stesso
+    `attempt_token`. Il bypass usava SOLO fatti autorevoli."""
+    ctx = governed_attempt(db, op="LSPCP:p", prompt="sequential")
+    a, s_, store, job = ctx["adapter"], ctx["spec"], ctx["store"], ctx["job"]
+    with open_grant(ctx):
+        a.authorize_payload(ctx["digest"])
+        first = a.submit(s_)
+    assert a.reached == 1, a.reached
+    persisted = store.get(job.job_id)
+    assert persisted.state is JobState.RESERVED, persisted.state   # NESSUN mark_submitted
+    claim = store.dispatch_claim(job.job_id)
+    assert claim and claim["attempt_token"] == ctx["token"]
+    e = must_raise(SpendAuthorizationInvalid, lambda: open_grant(ctx),
+                   code="DISPATCH_AUTHORIZATION_ALREADY_CLAIMED")
+    # e nemmeno due conii PRIMA di qualunque uso
+    ctx2 = governed_attempt(db + ".b", op="LSPCP:p2", prompt="sequential2")
+    g1 = open_grant(ctx2)
+    e2 = must_raise(SpendAuthorizationInvalid, lambda: open_grant(ctx2),
+                    code="DISPATCH_AUTHORIZATION_ALREADY_CLAIMED")
+    assert ctx2["adapter"].reached == 0
+    kinds = [x["kind"] for x in store.anomalies(job.job_id)]
+    assert "DISPATCH_AUTHORIZATION_ALREADY_CLAIMED" in kinds, kinds
+    assert a.reached == 1, a.reached
+    return (f"g1 dispaccia ({first.provider_job_id}), riga ancora {persisted.state.value}, "
+            f"claim persistito · g2 -> {e.code} · due conii prima di ogni uso -> {e2.code} · "
+            f"rifiuto registrato in anomalies · sentinella reached={a.reached} (max 1)")
+
+
+# ------------------------------------------------------------------- Q
+def q_same_attempt_two_threads(db: str) -> str:
+    import threading
+    ctx = governed_attempt(db, op="LSPCQ:q", prompt="threads")
+    a = ctx["adapter"]
+    start = threading.Barrier(2)
+    out: list[dict] = []
+    lock = threading.Lock()
+
+    def worker():
+        start.wait(timeout=30)
+        try:
+            g = open_grant(ctx)
+            r = {"claimed": True}
+        except BaseException as e:                              # noqa: BLE001
+            r = {"claimed": False, "code": getattr(e, "code", type(e).__name__)}
+        with lock:
+            out.append(r)
+
+    ts = [threading.Thread(target=worker) for _ in range(2)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join(60)
