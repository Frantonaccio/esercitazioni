+# ------------------------------------------------------------------- L
+def _forge_bypassing_constructor(**fields) -> DispatchAuthorization:
+    """Fabbrica un'autorizzazione AGGIRANDO `__post_init__`.
+
+    E' il tentativo serio: chi vuole falsificare non si ferma davanti a un
+    controllo nel costruttore. L'oggetto che ne esce ha i campi giusti, la classe
+    giusta ed e' frozen come l'originale — e non apre nulla, perche' cio' che conta
+    non e' come e' fatto ma DA DOVE viene."""
+    obj = object.__new__(DispatchAuthorization)
+    for k, v in fields.items():
+        object.__setattr__(obj, k, v)
+    return obj
+
+
+def l_forged_authorization(db: str) -> str:
+    a, s = SpenderSentinel(), spec("forged")
+    digest = hashlib.sha256(a.serialize(s)).hexdigest()
+    fields = dict(job_id="forged", spec_key=s.spec_key, operation_id="forged-op",
+                  attempt_token="forged-attempt", payload_digest=digest,
+                  provider=a.name, provider_account=a.account_id,
+                  envelope_id="forged-envelope", quote_id="forged-quote",
+                  quote_amount=1, quote_unit="units")
+
+    # L1 — il controesempio ESATTO della Human Review: costruzione diretta.
+    e1 = must_raise(SpendAuthorizationInvalid, lambda: DispatchAuthorization(**fields),
+                    code="DISPATCH_AUTHORIZATION_FORGED")
+
+    # L2 — costruzione che AGGIRA il costruttore, poi passata al grant privato.
+    forged = _forge_bypassing_constructor(**fields, mint=_base._MINT)
+    e2 = must_raise(SpendAuthorizationInvalid, lambda: _base._DispatchGrant(a, forged),
+                    code="DISPATCH_AUTHORIZATION_FORGED")
+
+    # L3 — la stessa, infilata a mano nello slot della concessione: i template
+    #      method non si fidano dello slot, verificano il registro.
+    _base._grant_slot(a).auth = forged
+    try:
+        e3 = must_raise(SpendAuthorizationInvalid, lambda: a.authorize_payload(digest),
+                        code="DISPATCH_AUTHORIZATION_FORGED")
+        e4 = must_raise(SpendAuthorizationInvalid, lambda: a.submit(s),
+                        code="DISPATCH_AUTHORIZATION_FORGED")
+    finally:
+        _base._grant_slot(a).auth = None
+
+    # L4 — un'autorizzazione con gli STESSI CAMPI di una legittima non e' quella
+    #      legittima: il registro e' per identita', non per uguaglianza.
+    assert DispatchAuthorization.__dataclass_params__.eq is False, \
+        "l'uguaglianza per campi renderebbe il registro falsificabile"
+    assert a.reached == 0 and a.authorized_calls == 0 and a.transport.sent_count == 0
+    return (f"costruzione diretta -> {e1.code} · costruttore aggirato + grant -> {e2.code} · "
+            f"slot forzato: authorize_payload -> {e3.code}, submit -> {e4.code} · "
+            f"eq per identita' · sentinella reached={a.reached} sent={a.transport.sent_count}")
+
+
+# ------------------------------------------------------------------- M
+def m_direct_implementation_hooks(db: str) -> str:
+    """`_dispatch` e `_authorize_payload` sono hook Python, e in Python il trattino
+    basso non e' un confine di sicurezza. Il guard lo applica la BASE in
+    `__init_subclass__`: la sottoclasse non deve ricordarsi di nulla."""
+    a, s = SpenderSentinel(), spec("hooks")
+    digest = hashlib.sha256(a.serialize(s)).hexdigest()
+    fields = dict(job_id="forged", spec_key=s.spec_key, operation_id="forged-op",
+                  attempt_token="forged-attempt", payload_digest=digest,
+                  provider=a.name, provider_account=a.account_id,
+                  envelope_id="forged-envelope", quote_id="forged-quote",
+                  quote_amount=1, quote_unit="units")
+    forged = _forge_bypassing_constructor(**fields, mint=_base._MINT)
+
+    # M1 — senza alcuna concessione attiva, con o senza autorizzazione presentata:
+    #      il guard si ferma sulla CONCESSIONE, che e' il fatto che manca davvero.
+    e1 = must_raise(SpendAuthorizationRequired, lambda: a._dispatch(s, None))
+    e2 = must_raise(SpendAuthorizationRequired, lambda: a._authorize_payload(digest, None))
+    e3 = must_raise(SpendAuthorizationRequired, lambda: a._dispatch(s, forged))
+    e4 = must_raise(SpendAuthorizationRequired, lambda: a._authorize_payload(digest, forged))
+    # M2 — con un'autorizzazione FABBRICATA forzata nello slot: il guard la
+    #      riconosce come non coniata.
+    _base._grant_slot(a).auth = forged
+    try:
+        e5 = must_raise(SpendAuthorizationInvalid, lambda: a._dispatch(s, forged),
+                        code="DISPATCH_AUTHORIZATION_FORGED")
+        e6 = must_raise(SpendAuthorizationInvalid, lambda: a._authorize_payload(digest, forged),
+                        code="DISPATCH_AUTHORIZATION_FORGED")
+    finally:
+        _base._grant_slot(a).auth = None
+    assert getattr(type(a).__dict__["_dispatch"], "__lspc_guarded__", False)
+    assert getattr(type(a).__dict__["_authorize_payload"], "__lspc_guarded__", False)
+    assert a.reached == 0 and a.authorized_calls == 0 and a.transport.sent_count == 0
+    return (f"senza concessione: _dispatch -> {e1.code}, _authorize_payload -> {e2.code} "
+            f"(idem con autorizzazione presentata: {e3.code}/{e4.code}) · con autorizzazione "
+            f"fabbricata nello slot -> {e5.code}/{e6.code} · hook avvolti dalla base · "
+            f"sentinella reached={a.reached} sent={a.transport.sent_count}")
+
+
