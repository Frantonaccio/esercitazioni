+#!/usr/bin/env python3
+"""LEGACY SPEND PATH CLOSURE — CONFINE DELLO SPENDER (2026-09-18).
+
+Controprove a livello di CORE del delta additivo `adapters.base.SpendCapableAdapter`
++ `authorize_dispatch` + `require_governed_dispatch_inputs`, e dell'allowlist
+opzionale `SqliteReservationStore(reconciliation_sources=...)`.
+
+Il bersaglio non e' "togliere la parola legacy": e' che un adapter capace di
+raggiungere un PROVIDER REALE non possa essere dispacciato se non attraverso il
+percorso governato. Qui il provider reale e' sostituito da una SENTINELLA che
+conta quante volte il confine e' stato attraversato: in ogni percorso non
+governato deve restare a ZERO.
+
+Cosa si dimostra:
+  A  il confine e' strutturale: una sottoclasse che ridefinisce `submit` o
+     `authorize_payload` non esiste (TypeError a tempo di definizione);
+  B  `adapter.submit(spec)` diretto -> SPEND_AUTHORIZATION_REQUIRED, sentinella 0;
+  C  `adapter.authorize_payload(d)` diretto -> SPEND_AUTHORIZATION_REQUIRED, sentinella 0;
+  D  `run_job` con i soli default (#10, il percorso legacy del Core) -> rifiuto
+     PRIMA della prenotazione: zero righe, zero ledger, zero quote consumate;
+  E  `run_job` con `envelope_units` (budget scelto dal client) -> rifiuto;
+  F  `run_job` GOVERNATO (operazione + quote fidata + envelope) -> il dispatch
+     avviene, la sentinella conta 1, il job e' SUCCEEDED;
+  G  l'autorizzazione e' RILETTA dal journal, non ricevuta: manomettere la riga
+     (quote non consumata da questo job, digest diverso, ownership diversa,
+     ledger senza RESERVE) rifiuta il dispatch;
+  H  la concessione e' a tempo determinato: fuori dal `with` non esiste piu',
+     non e' rientrante e non copre un'altra spec;
+  I  uno store senza autorita' di quote (JobStore in memoria) non autorizza;
+  J  `reconcile` (#11) con allowlist rifiuta una provenienza estranea e registra
+     il rifiuto; senza allowlist il comportamento e' invariato;
+  K  NON-REGRESSIONE: un adapter di laboratorio non spendibile passa da `run_job`
+     esattamente come prima, anche senza operazione/quote/envelope.
+
+Nessuna rete, nessun provider reale, nessun credito.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import shutil
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from adapters.base import (DispatchAuthorization, GenSpec, JobState, JobStore,
+                           ReconciliationEvidenceRequired, SpendAuthorizationInvalid,
+                           SpendAuthorizationRequired, SpendCapableAdapter, authorize_dispatch,
+                           grant_dispatch, is_spend_capable)
+from adapters.fake import FakeAdapter
+from registry.reservations import SqliteReservationStore
+from transport.pipeline import run_job
+
+GREEN, RED, DIM, RESET = "\033[32m", "\033[31m", "\033[2m", "\033[0m"
+RESULTS: list[tuple[str, bool, str]] = []
+
+
+# --------------------------------------------------------------- sentinella
+class SpenderSentinel(SpendCapableAdapter, FakeAdapter):
+    """Confine dello spender FITTIZIO. Al posto del provider reale c'e' un
+    contatore: `reached` sale SOLO se il dispatch e' stato autorizzato.
+
+    Non ridefinisce `submit` ne' `authorize_payload` (non potrebbe): implementa
+    i due hook del confine, che il template method chiama dopo aver verificato
+    la concessione."""
+
+    name = "fake_spender"
+
+    def __init__(self, **kw):
+        FakeAdapter.__init__(self, **kw)
+        self.reached = 0                 # dispatch effettivamente attraversati
+        self.authorized_calls = 0        # authorize_payload attraversate
+        self.seen: list[DispatchAuthorization] = []
+
+    def _authorize_payload(self, digest, auth):
+        self.authorized_calls += 1
+        return FakeAdapter.authorize_payload(self, digest)
+
+    def _dispatch(self, spec, auth):
+        self.reached += 1
+        self.seen.append(auth)
+        return FakeAdapter.submit(self, spec)
+
+
+def spec(prompt: str = "boundary", **kw) -> GenSpec:
+    d = dict(kind="image", model="fake_model_v1", prompt=prompt, project_id="LSPC_TEST")
+    d.update(kw)
+    return GenSpec(**d)
+
+
+def counts(store: SqliteReservationStore) -> dict:
+    import sqlite3
+    with sqlite3.connect(store.path) as c:
+        return {
+            "reservations": c.execute("SELECT COUNT(*) FROM reservations").fetchone()[0],
+            "ledger": c.execute("SELECT COUNT(*) FROM ledger").fetchone()[0],
+            "quotes_consumed": c.execute(
+                "SELECT COUNT(*) FROM quotes WHERE consumed_by IS NOT NULL").fetchone()[0],
+        }
+
+
+def governed(store: SqliteReservationStore, s: GenSpec, *, op: str, env: str = "ENV_LSPC",
+             amount: int = 10) -> dict:
+    """Lato AUTORITA': apre l'envelope ed emette la quote fidata. Il chiamante
+    non sceglie il prezzo: presenta solo il quote_id."""
+    store.open_envelope(env, 100, unit="synthetic_units", scope=None)
+    qid = store.issue_quote(operation_id=op, spec_key=s.spec_key, envelope_id=env,
+                            amount=amount, unit="synthetic_units")
+    return {"operation_id": op, "envelope_id": env, "quote_id": qid, "budget_units": amount}
+
+
+def must_raise(exc_types, fn, *, code=None):
+    try:
+        fn()
+    except exc_types as e:                                      # noqa: BLE001
+        got = getattr(e, "code", None)
+        if code is not None and got != code:
+            raise AssertionError(f"atteso code={code!r}, ottenuto {got!r}: {e}") from None
+        return e
+    raise AssertionError(f"atteso {exc_types}, nessuna eccezione")
+
+
+# ------------------------------------------------------------------- A
+def a_structural(db: str) -> str:
+    try:
+        class Override(SpendCapableAdapter, FakeAdapter):     # noqa: WPS431
+            name = "fake_bad"
+
+            def submit(self, spec):                           # noqa: ANN001
+                return None
+    except TypeError as e:
+        first = str(e)
+    else:
+        raise AssertionError("una sottoclasse che ridefinisce submit non deve esistere")
+    try:
+        class OverrideAuth(SpendCapableAdapter, FakeAdapter):  # noqa: WPS431
+            name = "fake_bad2"
+
+            def authorize_payload(self, digest):               # noqa: ANN001
+                return None
+    except TypeError as e:
+        second = str(e)
+    else:
+        raise AssertionError("una sottoclasse che ridefinisce authorize_payload non deve esistere")
+    # ordine di risoluzione sbagliato: FakeAdapter.submit precederebbe il confine
+    try:
+        class WrongMro(FakeAdapter, SpendCapableAdapter):      # noqa: WPS431
+            name = "fake_bad3"
+    except TypeError as e:
+        third = str(e)
+    else:
+        raise AssertionError("un MRO che scavalca il confine non deve esistere")
+    assert is_spend_capable(SpenderSentinel()) and not is_spend_capable(FakeAdapter())
+    return (f"submit -> TypeError · authorize_payload -> TypeError · MRO invertito -> TypeError "
+            f"({third.split(':')[0]}) · spend_capable: sentinella True, FakeAdapter False")
+
+
+# ------------------------------------------------------------------- B, C
+def b_direct_submit(db: str) -> str:
+    a = SpenderSentinel()
+    s = spec()
+    e = must_raise(SpendAuthorizationRequired, lambda: a.submit(s))
+    assert a.reached == 0 and a.submits == 0 and a.transport.sent_count == 0
+    return (f"submit diretto -> {e.code} · sentinella reached={a.reached} · "
+            f"transport sent={a.transport.sent_count}")
+
+
+def c_direct_authorize(db: str) -> str:
+    a = SpenderSentinel()
+    digest = hashlib.sha256(a.serialize(spec())).hexdigest()
+    e = must_raise(SpendAuthorizationRequired, lambda: a.authorize_payload(digest))
+    assert a.authorized_calls == 0 and not a.transport.authorized
+    return (f"authorize_payload diretto -> {e.code} · attraversamenti={a.authorized_calls} · "
+            f"digest autorizzati nel trasporto={len(a.transport.authorized)}")
+
+
+# ------------------------------------------------------------------- D, E
+def d_legacy_run_job(db: str) -> str:
+    store, a, s = SqliteReservationStore(db), SpenderSentinel(), spec("legacy")
+    before = counts(store)
+    e = must_raise(SpendAuthorizationRequired, lambda: run_job(a, s, store, max_polls=3))
+    after = counts(store)
+    assert before == after == {"reservations": 0, "ledger": 0, "quotes_consumed": 0}
+    assert a.reached == 0 and a.submits == 0 and a.transport.sent_count == 0
+    return (f"run_job coi soli default -> {e.code} · righe {after['reservations']} · "
+            f"ledger {after['ledger']} · quote consumate {after['quotes_consumed']} · "
+            f"sentinella reached=0 · sent=0")
+
+
+def e_envelope_units_forbidden(db: str) -> str:
+    store, a, s = SqliteReservationStore(db), SpenderSentinel(), spec("envunits")
+    g = governed(store, s, op="LSPC:e")
+    e = must_raise(SpendAuthorizationRequired,
+                   lambda: run_job(a, s, store, max_polls=3, budget_units=10,
+                                   envelope_units=1000, operation_id=g["operation_id"],
+                                   quote_id=g["quote_id"], envelope_id=g["envelope_id"]))
+    c = counts(store)
+    assert c["reservations"] == 0 and c["quotes_consumed"] == 0 and a.reached == 0
+    return (f"envelope_units nel percorso spendibile -> {e.code} · righe 0 · "
+            f"quote consumate 0 · sentinella reached=0")
+
+
+# ------------------------------------------------------------------- F
+def f_governed_dispatch(db: str) -> str:
+    store, a, s = SqliteReservationStore(db), SpenderSentinel(), spec("governed")
+    g = governed(store, s, op="LSPC:f")
+    job = run_job(a, s, store, max_polls=5, budget_units=g["budget_units"],
+                  operation_id=g["operation_id"], quote_id=g["quote_id"],
+                  envelope_id=g["envelope_id"])
+    persisted = store.get(job.job_id)
+    auth = a.seen[0]
+    assert persisted.state is JobState.SUCCEEDED, persisted.state
+    assert a.reached == 1 and a.authorized_calls == 1 and a.transport.sent_count == 1
+    assert auth.job_id == job.job_id and auth.quote_id == g["quote_id"]
+    assert auth.envelope_id == g["envelope_id"] and auth.quote_amount == g["budget_units"]
+    assert auth.operation_id == g["operation_id"] and auth.spec_key == s.spec_key
+    assert auth.payload_digest == persisted.payload_digest
+    assert auth.attempt_token == persisted.attempt_token
+    return (f"governato -> {persisted.state.value} · sentinella reached=1 · "
+            f"authorize_payload=1 · autorizzazione: op={auth.operation_id} "
+            f"quote={auth.quote_id[:14]}… env={auth.envelope_id} importo={auth.quote_amount} "
+            f"{auth.quote_unit} · digest e attempt_token = journal")
+
+
+# ------------------------------------------------------------------- G
+def g_authorization_is_reread(db: str) -> str:
+    """L'autorizzazione non e' ricevuta: e' ricostruita dal journal. Qui la si
+    chiede direttamente, con la riga persistita manomessa in ogni modo utile."""
+    import sqlite3
+    store, a, s = SqliteReservationStore(db), SpenderSentinel(), spec("reread")
+    g = governed(store, s, op="LSPC:g")
+    outcome, job = store.reserve_or_get_live(
+        s, budget_units=g["budget_units"], now=1.0, operation_id=g["operation_id"],
+        quote_id=g["quote_id"], envelope_id=g["envelope_id"])
+    payload = a.serialize(s)
+    digest = hashlib.sha256(payload).hexdigest()
+    token = "att_deadbeefdeadbeefdeadbeef"
+    job = store.mark_submitting(job, provider=a.name, provider_account=a.account_id,
+                                payload_digest=digest, attempt_token=token, now=1.0)
+
+    def ask(**over):
+        kw = dict(adapter_name=a.name, adapter_account=a.account_id, spec_key=s.spec_key,
+                  payload_digest=digest, attempt_token=token)
+        kw.update(over)
+        return authorize_dispatch(store, job.job_id, **kw)
+
+    ok = ask()
+    assert ok.job_id == job.job_id
+    codes = []
+    codes.append(must_raise(SpendAuthorizationInvalid, lambda: ask(attempt_token="att_altro")).code)
+    codes.append(must_raise(SpendAuthorizationInvalid, lambda: ask(payload_digest="0" * 64)).code)
+    codes.append(must_raise(SpendAuthorizationInvalid, lambda: ask(adapter_account="altro_conto")).code)
+    codes.append(must_raise(SpendAuthorizationInvalid, lambda: ask(adapter_name="fake_altro")).code)
+    codes.append(must_raise(SpendAuthorizationInvalid,
+                            lambda: authorize_dispatch(store, "res_inesistente_1",
+                                                       adapter_name=a.name,
+                                                       adapter_account=a.account_id,
+                                                       spec_key=s.spec_key, payload_digest=digest,
+                                                       attempt_token=token)).code)
+    # la quote non e' piu' consumata da questo job: l'importo non e' impegnato da lui
+    with sqlite3.connect(store.path) as c:
+        c.execute("UPDATE quotes SET consumed_by='res_altro_1' WHERE quote_id=?", (g["quote_id"],))
+    codes.append(must_raise(SpendAuthorizationInvalid, ask).code)
+    with sqlite3.connect(store.path) as c:
+        c.execute("UPDATE quotes SET consumed_by=? WHERE quote_id=?", (job.job_id, g["quote_id"]))
+    # nessun movimento RESERVE: l'envelope non risulta impegnato
+    with sqlite3.connect(store.path) as c:
+        c.execute("DELETE FROM ledger WHERE job_id=? AND kind='RESERVE'", (job.job_id,))
+    codes.append(must_raise(SpendAuthorizationInvalid, ask).code)
+    # una riga senza quote_id non autorizza nulla
+    with sqlite3.connect(store.path) as c:
+        c.execute("UPDATE reservations SET quote_id=NULL WHERE job_id=?", (job.job_id,))
+    codes.append(must_raise(SpendAuthorizationInvalid, ask).code)
+    assert a.reached == 0
+    return "rifiuti: " + " · ".join(codes) + " · sentinella reached=0"
+
+
+# ------------------------------------------------------------------- H
+def h_grant_is_bounded(db: str) -> str:
+    store, a, s = SqliteReservationStore(db), SpenderSentinel(), spec("grant")
+    g = governed(store, s, op="LSPC:h")
+    run_job(a, s, store, max_polls=5, budget_units=g["budget_units"],
+            operation_id=g["operation_id"], quote_id=g["quote_id"], envelope_id=g["envelope_id"])
+    auth = a.seen[0]
+    reached_after_governed = a.reached
+    # fuori dal `with` la concessione non esiste piu'
+    e1 = must_raise(SpendAuthorizationRequired, lambda: a.submit(s))
+    # non e' rientrante
+    with grant_dispatch(a, auth):
+        e2 = must_raise(SpendAuthorizationInvalid,
+                        lambda: grant_dispatch(a, auth).__enter__(),
+                        code="DISPATCH_GRANT_REENTRANT")
+    # non copre un'altra spec
+    other = spec("grant_altra")
+    with grant_dispatch(a, auth):
+        e3 = must_raise(SpendAuthorizationInvalid, lambda: a.submit(other),
+                        code="DISPATCH_SPEC_NOT_COVERED")
+        e4 = must_raise(SpendAuthorizationInvalid, lambda: a.authorize_payload("0" * 64),
+                        code="DISPATCH_DIGEST_NOT_COVERED")
+    assert a.reached == reached_after_governed == 1
+    return (f"fuori dal with -> {e1.code} · rientrante -> {e2.code} · altra spec -> {e3.code} · "
+            f"altro digest -> {e4.code} · sentinella reached resta {a.reached}")
+
+
+# ------------------------------------------------------------------- I
+def i_store_without_quote_authority(db: str) -> str:
+    """Due modi in cui uno store puo' non essere un'autorita' economica, e nessuno
+    dei due lascia passare un dispatch."""
+    a, s = SpenderSentinel(), spec("inmemory")
+    # i1) lo store in memoria rifiuta gli input governati ancora prima: contratto
+    #     esplicito del Core, invariato da questa fase.
+    from adapters.base import ReservationContractError
+    e1 = must_raise(ReservationContractError,
+                    lambda: run_job(a, s, JobStore(), max_polls=3, budget_units=10,
+                                    operation_id="LSPC:i", quote_id="quote_inventata",
+                                    envelope_id="ENV_X"))
+    # i2) uno store che accettasse quegli input ma non esponesse l'autorita' della
+    #     quote non autorizza comunque: `authorize_dispatch` non ha nulla da rileggere.
+    durable = SqliteReservationStore(db)
+    g = governed(durable, s, op="LSPC:i2")
+    outcome, job = durable.reserve_or_get_live(
+        s, budget_units=g["budget_units"], now=1.0, operation_id=g["operation_id"],
+        quote_id=g["quote_id"], envelope_id=g["envelope_id"])
+    digest = hashlib.sha256(a.serialize(s)).hexdigest()
+    job = durable.mark_submitting(job, provider=a.name, provider_account=a.account_id,
+                                  payload_digest=digest, attempt_token="att_" + "0" * 24, now=1.0)
+
+    class NoQuoteAuthority:
+        """Stesso journal, nessuna autorita' economica esposta."""
+        def get(self, job_id):
+            return durable.get(job_id)
+
+    e2 = must_raise(SpendAuthorizationInvalid,
+                    lambda: authorize_dispatch(NoQuoteAuthority(), job.job_id,
+                                               adapter_name=a.name, adapter_account=a.account_id,
+                                               spec_key=s.spec_key, payload_digest=digest,
+                                               attempt_token="att_" + "0" * 24),
+                    code="DISPATCH_QUOTE_AUTHORITY_MISSING")
+    assert a.reached == 0 and a.transport.sent_count == 0
+    return (f"store in memoria -> ReservationContractError ({str(e1)[:38]}…) · store senza "
+            f"autorita' della quote -> {e2.code} · sentinella reached=0 · sent=0")
+
+
+# ------------------------------------------------------------------- J
+def j_reconciliation_allowlist(db: str) -> str:
+    s = spec("reconcile")
+    restricted = SqliteReservationStore(db, reconciliation_sources=["PROVIDER_API"])
+    _, job = restricted.reserve_or_get_live(s, budget_units=0, now=1.0, operation_id="LSPC:j")
+    forged = {"source": "FABBRICATA", "remote_ref": "x:1"}
+    e = must_raise(ReconciliationEvidenceRequired,
+                   lambda: restricted.reconcile(job, JobState.FAILED, forged, now=2.0))
+    assert restricted.get(job.job_id).state is JobState.RESERVED
+    kinds = [a["kind"] for a in restricted.anomalies(job.job_id)]
+    assert "RECONCILIATION_SOURCE_REFUSED" in kinds, kinds
+    good = restricted.reconcile(job, JobState.FAILED,
+                                {"source": "PROVIDER_API", "remote_ref": "pv:1"}, now=3.0)
+    assert good.state is JobState.FAILED
+    # senza allowlist: comportamento invariato (non-regressione)
+    open_store = SqliteReservationStore(db + ".open")
+    _, j2 = open_store.reserve_or_get_live(s, budget_units=0, now=1.0, operation_id="LSPC:j2")
+    assert open_store.reconcile(j2, JobState.FAILED, forged, now=2.0).state is JobState.FAILED
+    return (f"provenienza estranea -> {str(e)[:52]}… · stato invariato RESERVED · anomalia "
+            f"registrata · provenienza riconosciuta -> FAILED · store senza allowlist: invariato")
+
+
+# ------------------------------------------------------------------- K
+def k_lab_adapter_unchanged(db: str) -> str:
+    """NON-REGRESSIONE. Un adapter di laboratorio non spendibile passa da run_job
+    coi soli default, esattamente come nel Core 9cf9cee1."""
+    store, a, s = SqliteReservationStore(db), FakeAdapter(), spec("lab")
+    job = run_job(a, s, store, max_polls=5)
+    persisted = store.get(job.job_id)
+    assert persisted.state is JobState.SUCCEEDED and a.submits == 1
+    assert persisted.operation_id is None and persisted.quote_id is None
+    # anche envelope_units resta ammesso per il laboratorio
+    b, s2 = FakeAdapter(), spec("lab2")
+    job2 = run_job(b, s2, store, max_polls=5, budget_units=5, envelope_units=50)
+    assert store.get(job2.job_id).state is JobState.SUCCEEDED
+    return (f"FakeAdapter senza operazione/quote/envelope -> {persisted.state.value} "
+            f"(submits {a.submits}) · envelope_units -> "
+            f"{store.get(job2.job_id).state.value} · nessun confine attraversato")
+
+
+def check(name, fn):
+    try:
+        RESULTS.append((name, True, fn() or ""))
+    except Exception as e:                                      # noqa: BLE001
+        import traceback
+        RESULTS.append((name, False, f"{type(e).__name__}: {e}\n{traceback.format_exc(limit=3)}"))
+
+
+def main() -> int:
+    tmp = tempfile.mkdtemp(prefix="lspc_core_")
+    try:
+        for key, name, fn in (
+                ("a", "A. il confine e' strutturale (TypeError a definizione della classe)", a_structural),
+                ("b", "B. submit diretto rifiutato, sentinella a 0", b_direct_submit),
+                ("c", "C. authorize_payload diretto rifiutato, sentinella a 0", c_direct_authorize),
+                ("d", "D. run_job legacy (#10) rifiutato PRIMA della prenotazione", d_legacy_run_job),
+                ("e", "E. envelope_units (budget del client) vietato allo spender", e_envelope_units_forbidden),
+                ("f", "F. percorso governato: il dispatch avviene e porta l'autorizzazione", f_governed_dispatch),
+                ("g", "G. l'autorizzazione e' riletta dal journal, non ricevuta", g_authorization_is_reread),
+                ("h", "H. la concessione e' limitata al with, alla spec e al digest", h_grant_is_bounded),
+                ("i", "I. store senza autorita' economica: nessun dispatch", i_store_without_quote_authority),
+                ("j", "J. reconcile (#11): allowlist delle provenienze", j_reconciliation_allowlist),
+                ("k", "K. NON-REGRESSIONE: adapter di laboratorio invariato", k_lab_adapter_unchanged)):
+            check(name, lambda fn=fn, key=key: fn(os.path.join(tmp, f"{key}.db")))
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+    ok = 0
+    for name, passed, detail in RESULTS:
+        mark = f"{GREEN}PASS{RESET}" if passed else f"{RED}FAIL{RESET}"
+        print(f"{mark}  {name}\n      {DIM}{detail}{RESET}")
+        ok += passed
+    print(f"\nSPENDER BOUNDARY (Core): {ok}/{len(RESULTS)} PASS")
+    print("crediti spesi: 0 · provider reali: 0 · rete generativa: 0")
+    return 0 if ok == len(RESULTS) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
