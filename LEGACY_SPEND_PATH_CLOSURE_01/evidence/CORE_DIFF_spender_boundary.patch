+# ------------------------------------------------------------------- O
+def o_legitimate_authorization_not_replayable(db: str) -> str:
+    """Un'autorizzazione legittima vale per UN tentativo. Fuori dal suo `with` e'
+    consumata, e nessun varco la riaccetta: un replay e' una seconda spesa."""
+    store, a, s = SqliteReservationStore(db), SpenderSentinel(), spec("replay")
+    g = governed(store, s, op="LSPC:o")
+    run_job(a, s, store, max_polls=5, budget_units=g["budget_units"],
+            operation_id=g["operation_id"], quote_id=g["quote_id"], envelope_id=g["envelope_id"])
+    assert a.reached == 1
+    auth = a.seen[0]
+    assert _base._is_minted(auth), "l'autorizzazione del percorso governato deve essere coniata"
+    e1 = must_raise(SpendAuthorizationInvalid, lambda: _base._DispatchGrant(a, auth),
+                    code="DISPATCH_AUTHORIZATION_SPENT")
+    _base._grant_slot(a).auth = auth
+    try:
+        e2 = must_raise(SpendAuthorizationInvalid, lambda: a.submit(s),
+                        code="DISPATCH_AUTHORIZATION_SPENT")
+        e3 = must_raise(SpendAuthorizationInvalid,
