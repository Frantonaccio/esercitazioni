+                                payload_digest=digest, attempt_token=token, now=1.0)
+    return {"store": store, "adapter": a, "spec": s_, "job": job, "digest": digest,
+            "token": token, "quote_id": qid, "envelope_id": e}
+
+
+def open_grant(ctx: dict):
+    return grant_dispatch(ctx["adapter"], ctx["store"], ctx["job"].job_id,
+                          spec_key=ctx["spec"].spec_key, payload_digest=ctx["digest"],
+                          attempt_token=ctx["token"])
+
+
+def must_raise(exc_types, fn, *, code=None):
+    try:
+        fn()
+    except exc_types as e:                                      # noqa: BLE001
+        got = getattr(e, "code", None)
+        if code is not None and got != code:
+            raise AssertionError(f"atteso code={code!r}, ottenuto {got!r}: {e}") from None
+        return e
+    raise AssertionError(f"atteso {exc_types}, nessuna eccezione")
+
+
+# ------------------------------------------------------------------- A
+def a_structural(db: str) -> str:
+    try:
+        class Override(SpendCapableAdapter, FakeAdapter):     # noqa: WPS431
+            name = "fake_bad"
+
+            def submit(self, spec):                           # noqa: ANN001
+                return None
+    except TypeError as e:
+        first = str(e)
+    else:
+        raise AssertionError("una sottoclasse che ridefinisce submit non deve esistere")
+    try:
+        class OverrideAuth(SpendCapableAdapter, FakeAdapter):  # noqa: WPS431
+            name = "fake_bad2"
+
+            def authorize_payload(self, digest):               # noqa: ANN001
+                return None
+    except TypeError as e:
+        second = str(e)
+    else:
+        raise AssertionError("una sottoclasse che ridefinisce authorize_payload non deve esistere")
+    # ordine di risoluzione sbagliato: FakeAdapter.submit precederebbe il confine
+    try:
+        class WrongMro(FakeAdapter, SpendCapableAdapter):      # noqa: WPS431
+            name = "fake_bad3"
+    except TypeError as e:
+        third = str(e)
+    else:
+        raise AssertionError("un MRO che scavalca il confine non deve esistere")
+    assert is_spend_capable(SpenderSentinel()) and not is_spend_capable(FakeAdapter())
+    return (f"submit -> TypeError · authorize_payload -> TypeError · MRO invertito -> TypeError "
+            f"({third.split(':')[0]}) · spend_capable: sentinella True, FakeAdapter False")
+
