+    assert len(claimed) == 1, out
+    assert refused[0]["code"] == "DISPATCH_AUTHORIZATION_ALREADY_CLAIMED", refused
+    assert a.reached == 0
+    return (f"2 thread sullo stesso attempt -> 1 claim, 1 {refused[0]['code']} · "
