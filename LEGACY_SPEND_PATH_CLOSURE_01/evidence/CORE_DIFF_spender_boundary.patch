+def n_grant_requires_the_store(db: str) -> str:
+    """Non esiste piu' una forma di `grant_dispatch` che accetti una capability."""
+    import inspect
+    sig = inspect.signature(grant_dispatch)
+    params = list(sig.parameters)
+    assert params[:3] == ["adapter", "store", "job_id"], params
+    assert "auth" not in sig.parameters and "authorization" not in sig.parameters, params
+    a, s = SpenderSentinel(), spec("shape")
+    digest = hashlib.sha256(a.serialize(s)).hexdigest()
+    forged = _forge_bypassing_constructor(
+        job_id="forged", spec_key=s.spec_key, operation_id="op", attempt_token="t",
+        payload_digest=digest, provider=a.name, provider_account=a.account_id,
+        envelope_id="e", quote_id="q", quote_amount=1, quote_unit="units", mint=_base._MINT)
+    # la vecchia chiamata a due argomenti non esiste piu'
+    e = must_raise(TypeError, lambda: grant_dispatch(a, forged))
+    assert a.reached == 0
+    return (f"firma: {params[:3]} + keyword-only {sorted(k for k, v in sig.parameters.items() if v.kind == v.KEYWORD_ONLY)} · "
+            f"grant_dispatch(adapter, auth) -> TypeError · sentinella reached={a.reached}")
+
