+# ---------------------------------------------------------------------------
+# HUMAN REVIEW 01 — DISPATCH_AUTHORIZATION_FORGEABLE (2026-09-18)
+#
+# IL DIFETTO CHE QUESTA SEZIONE CORREGGE. Nella prima stesura del confine
+# `DispatchAuthorization` era una dataclass costruibile e `grant_dispatch(adapter,
+# auth)` accettava l'oggetto senza rileggere nulla. Bastava quindi:
+#
+#     forged = DispatchAuthorization(job_id="forged", spec_key=spec.spec_key, ...)
+#     with grant_dispatch(adapter, forged):
+#         adapter.authorize_payload(digest); adapter.submit(spec)
+#
+# e lo spender veniva raggiunto (riprodotto: `reached=1`, `sent=1`). L'autorizzazione
+# era "derivata dal journal" solo per convenzione del chiamante — cioe' non lo era.
+# Una dataclass frozen rende l'oggetto immutabile, non autentico.
+#
+# TRE MECCANISMI, NON UNO. Nessuno da solo basta, e sono deliberatamente ridondanti:
+#
+#  1. `grant_dispatch(...)` NON riceve piu' un'autorizzazione. Riceve lo STORE
+#     AUTOREVOLE e l'identita' del tentativo, e chiama internamente
+#     `authorize_dispatch(store, ...)`. L'unica strada supportata per aprire il
+#     cancello implica una NUOVA lettura del journal.
+#  2. `DispatchAuthorization` non e' costruibile dall'esterno: il costruttore
+#     pretende un token di conio privato del modulo, e senza quello solleva
+#     DISPATCH_AUTHORIZATION_FORGED. Il controesempio della review fallisce qui,
+#     prima ancora di arrivare al grant.
+#  3. Ogni punto che apre il confine (`_DispatchGrant.__enter__`, `submit`,
+#     `authorize_payload` e gli hook di implementazione) verifica che l'oggetto sia
+#     nel registro dei coniati, PER IDENTITA' — non per uguaglianza di campi — e che
+#     non sia gia' stato consumato. Un'autorizzazione legittima non si riusa.
+#
+# COSA QUESTO NON PRETENDE DI ESSERE. In Python il trattino basso non e' un confine
+# di sicurezza, e questo modulo non finge il contrario. Codice arbitrariamente
+# malevolo eseguito NELLO STESSO PROCESSO, con la stessa identita' e le stesse
+# credenziali dello spender, puo' importare un nome privato o scrivere nello slot
+# della concessione. Contro quello il confine e' P-B01: UID distinto, nessuna
+# capability, `no_new_privs`, segreto e store leggibili solo nel dominio dello
+# spender. Vedi THREAT_MODEL.md del bundle di questa fase.
+# ---------------------------------------------------------------------------
+
+# Token di conio: privato del modulo, senza valore semantico, identificato SOLO per
+# identita'. Non e' un booleano e non e' una stringa: quelli si scrivono, questo no.
+_MINT = object()
+
+# Registro delle autorizzazioni realmente coniate da `authorize_dispatch`, per
+# IDENTITA'. `WeakSet` perche' un'autorizzazione non deve sopravvivere al proprio
+# tentativo; il lock perche' `Batch.go` dispaccia in thread paralleli.
+_MINTED: "weakref.WeakSet" = weakref.WeakSet()
+_SPENT: "weakref.WeakSet" = weakref.WeakSet()
+_MINT_LOCK = threading.Lock()
+
+
+def _register_minted(auth: "DispatchAuthorization") -> "DispatchAuthorization":
+    with _MINT_LOCK:
+        _MINTED.add(auth)
+    return auth
+
+
+def _is_minted(auth) -> bool:
+    if not isinstance(auth, DispatchAuthorization):
+        return False
+    with _MINT_LOCK:
+        return any(a is auth for a in _MINTED)
+
+
+def _is_spent(auth) -> bool:
+    with _MINT_LOCK:
+        return any(a is auth for a in _SPENT)
+
+
+def _mark_spent(auth) -> None:
+    with _MINT_LOCK:
+        _SPENT.add(auth)
+
+
+def _require_minted(auth, entry_point: str) -> "DispatchAuthorization":
+    """Unico punto che decide se un'autorizzazione e' autentica. Chiamato da OGNI
+    varco: il grant, i due template method e i due hook di implementazione."""
+    if auth is None:
+        raise SpendAuthorizationRequired(entry_point, "nessuna concessione attiva in questo thread")
+    if not _is_minted(auth):
+        raise SpendAuthorizationInvalid(
+            "DISPATCH_AUTHORIZATION_FORGED",
+            f"{entry_point}: l'autorizzazione presentata non e' stata emessa da "
+            f"`authorize_dispatch` su un journal autorevole. Un oggetto con i campi giusti "
+            f"non e' un'autorizzazione: e' una fotocopia.")
+    if _is_spent(auth):
+        raise SpendAuthorizationInvalid(
+            "DISPATCH_AUTHORIZATION_SPENT",
+            f"{entry_point}: autorizzazione gia' consumata dal tentativo {auth.job_id}. "
+            f"Un nuovo dispatch richiede una nuova lettura del journal.")
+    return auth
+
+
+@dataclass(frozen=True, eq=False)
+class DispatchAuthorization:
+    """Fatti RILETTI dal journal autorevole. Non e' un permesso emesso: e' una
+    fotografia verificata della prenotazione governata che sta per dispacciare.
+
+    `eq=False` e' deliberato: l'identita' di un'autorizzazione e' l'OGGETTO, non i
+    suoi campi. Due autorizzazioni con gli stessi campi non sono la stessa
+    autorizzazione, ed e' esattamente cio' che rende inutile fabbricarne una."""
+    job_id: str
+    spec_key: str
+    operation_id: str
+    attempt_token: str
+    payload_digest: str
+    provider: str
+    provider_account: str
+    envelope_id: str
+    quote_id: str
+    quote_amount: int
+    quote_unit: str
+    mint: Any = None            # token di conio: solo `authorize_dispatch` lo possiede
+
+    def __post_init__(self):
+        if self.mint is not _MINT:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_AUTHORIZATION_FORGED",
+                "DispatchAuthorization non si costruisce: la si ottiene da "
+                "`authorize_dispatch(store, ...)`, che la deriva dal journal autorevole")
+
+    def covers(self, spec: "GenSpec") -> bool:
+        return getattr(spec, "spec_key", None) == self.spec_key
+
+
+def is_spend_capable(adapter) -> bool:
+    """Vero se l'adapter dichiara di poter raggiungere un provider reale."""
+    return bool(getattr(adapter, SPEND_CAPABLE_ATTR, False))
+
