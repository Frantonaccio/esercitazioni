+# ===========================================================================
+# SPENDER BOUNDARY (LEGACY SPEND PATH CLOSURE, 2026-09-18)
+#
+# IL PROBLEMA CHIUSO QUI. Fino a `9cf9cee1` il Core esponeva DUE primitive che
+# potevano raggiungere un provider senza passare dal percorso governato:
+#
+#   #10  `transport.pipeline.run_job(adapter, spec, store)` invocato con i soli
+#        default (nessuna operazione, nessuna quote, nessun envelope) e
+#        `adapter.submit(spec)` invocato direttamente;
+#   #11  `SqliteReservationStore.reconcile(...)` con evidenza arbitraria.
+#
+# Nessun interruttore del RUNTIME poteva chiuderle: pin, intent e authorization
+# sono concetti del Runtime, non del Core. Chiunque avesse il Core in `sys.path`
+# e un adapter poteva spendere (LEGACY_SPEND_PATHS_CORE_PRIMITIVES =
+# CORE_CHANGE_REQUIRED).
+#
+# COSA NON E' IL TARGET. Non e' "togliere la parola legacy", e non e' "eliminare
+# le API del Core perche' potrebbero essere usate male": `run_job`, `submit` e
+# `reconcile` restano esattamente dove sono, con la stessa firma, e i percorsi di
+# laboratorio (adapter deterministici, nessun provider) continuano a funzionare
+# invariati.
+#
+# IL TARGET E': un adapter capace di raggiungere un PROVIDER REALE — uno
+# SPENDER — non puo' essere dispacciato se non attraverso il percorso governato.
+#
+# COME. Un adapter spendibile dichiara `spend_capable = True` derivando da
+# `SpendCapableAdapter`. Per quella classe `submit` e `authorize_payload` NON
+# sono sovrascrivibili (`__init_subclass__` lo impedisce a tempo di definizione
+# della classe): sono metodi-template che pretendono, PRIMA di qualunque
+# effetto, una `DispatchAuthorization` valida per QUESTA spec.
+#
+# PERCHE' L'AUTORIZZAZIONE NON E' FALSIFICABILE. Non e' un token che il
+# chiamante puo' costruire: e' un FATTO RILETTO DAL JOURNAL AUTOREVOLE. Per
+# ottenerla servono, nella riga persistita del tentativo:
+#
+#   - stato RESERVED senza identita' remota (siamo davvero pre-submit);
+#   - `operation_id` presente;
+#   - `attempt_token` e `payload_digest` presenti e coincidenti con quelli che
+#     il Core sta per usare;
+#   - `provider` / `provider_account` coincidenti con l'adapter;
+#   - `quote_id` presente, quote esistente, CONSUMATA DA QUESTO job, legata
+#     alla stessa operazione, alla stessa spec e a un envelope;
+#   - una riga di ledger `RESERVE` per questo job.
+#
+# Tutto cio' nasce SOLO dentro `reserve_or_get_live`, in UNA transazione, che
+# consuma la quote e impegna l'envelope. Fabbricarlo significherebbe scrivere a
+# mano nel database dello spender — che e' gia' fuori dal modello di minaccia
+# (vedi `registry/reservations.py`) ed e' esattamente cio' che il confine di
+# processo P-B01 nega all'orchestrator.
+#
+# CIO' CHE IL CONFINE NON PRETENDE DI FARE. Non impedisce a un adapter di
+# laboratorio non spendibile (`FakeAdapter`) di essere usato direttamente: e'
+# deliberato e verificato: la suite storica R0-R1 continua a girare invariata.
+# La distinzione e' `spend_capable`, cioe' "questo adapter puo' arrivare a un
+# provider vero", e sta all'autore dell'adapter dichiararla — esattamente come
+# sta a lui non mettere una chiave API dentro un FakeAdapter.
+# ===========================================================================
+
+SPEND_CAPABLE_ATTR = "spend_capable"
+
+
+class SpendAuthorizationRequired(Exception):
+    """Un adapter spendibile e' stato dispacciato fuori dal percorso governato.
+
+    Sollevata PRIMA di qualunque effetto esterno: nessuna credenziale letta,
+    nessun subprocess, nessuna rete, nessun job remoto, nessun credito."""
+
+    code = "SPEND_AUTHORIZATION_REQUIRED"
+
+    def __init__(self, entry_point: str, detail: str = ""):
+        self.entry_point = entry_point
+        super().__init__(
+            f"{self.code}: {entry_point} richiede una DispatchAuthorization emessa dal "
+            f"percorso governato (reservation atomica con operazione, quote fidata ed "
+            f"envelope){(': ' + detail) if detail else ''}. Nessun invio, nessuna spesa.")
+
+
+class SpendAuthorizationInvalid(Exception):
+    """Il journal autorevole non autorizza questo dispatch. Fail-closed, parametrico."""
+
+    def __init__(self, code: str, message: str):
+        self.code = code
+        super().__init__(f"{code}: {message}")
+
+
+@dataclass(frozen=True)
+class DispatchAuthorization:
+    """Fatti RILETTI dal journal autorevole. Non e' un permesso emesso: e' una
+    fotografia verificata della prenotazione governata che sta per dispacciare."""
+    job_id: str
+    spec_key: str
+    operation_id: str
+    attempt_token: str
+    payload_digest: str
+    provider: str
+    provider_account: str
+    envelope_id: str
+    quote_id: str
+    quote_amount: int
+    quote_unit: str
+
+    def covers(self, spec: "GenSpec") -> bool:
+        return getattr(spec, "spec_key", None) == self.spec_key
+
+
+def is_spend_capable(adapter) -> bool:
+    """Vero se l'adapter dichiara di poter raggiungere un provider reale."""
+    return bool(getattr(adapter, SPEND_CAPABLE_ATTR, False))
+
+
+def require_governed_dispatch_inputs(*, operation_id, quote_id, envelope_id,
+                                     envelope_units, entry_point: str) -> None:
+    """Rifiuto PRIMA della prenotazione per un adapter spendibile chiamato senza
+    gli input del percorso governato. Zero effetti: nessuna riga, nessun ledger.
+
+    `envelope_units` (budget scelto dal CLIENT) e' vietato in modo esplicito: nel
+    percorso spendibile il prezzo viene dall'autorita' della quote, mai dal
+    chiamante. Il percorso `envelope_units` resta intatto per gli adapter di
+    laboratorio non spendibili."""
+    missing = [n for n, v in (("operation_id", operation_id), ("quote_id", quote_id),
+                              ("envelope_id", envelope_id))
+               if not isinstance(v, str) or not v.strip()]
+    if missing:
+        raise SpendAuthorizationRequired(
+            entry_point, f"input governati mancanti: {', '.join(missing)}")
+    if envelope_units is not None:
+        raise SpendAuthorizationRequired(
+            entry_point, "envelope_units (budget scelto dal client) non e' ammesso per un "
+                         "adapter spendibile: l'importo viene dalla quote fidata")
+
+
+def _ledger_has_reserve(store, job_id: str) -> bool:
+    rows = getattr(store, "ledger", None)
+    if not callable(rows):
+        return False
+    try:
+        return any(r.get("kind") == "RESERVE" for r in rows(job_id) or ())
+    except Exception:                                       # noqa: BLE001
+        return False
+
+
+def authorize_dispatch(store, job_id: str, *, adapter_name: str, adapter_account: str,
+                       spec_key: str, payload_digest: str, attempt_token: str,
+                       entry_point: str = "authorize_dispatch") -> DispatchAuthorization:
+    """Ricostruisce l'autorizzazione al dispatch DAL JOURNAL AUTOREVOLE.
+
+    Non accetta nulla dal chiamante che non venga riconfrontato con la riga
+    persistita. Solleva `SpendAuthorizationInvalid` con un codice parlante al
+    primo fatto che manca: nessun fallback, nessun "quasi"."""
+    def refuse(code: str, msg: str):
+        raise SpendAuthorizationInvalid(code, f"{entry_point}: {msg}")
+
+    persisted = store.get(job_id)
+    if persisted is None:
+        refuse("DISPATCH_JOB_UNKNOWN", f"job {job_id} sconosciuto allo store autorevole")
+    if persisted.state is not JobState.RESERVED or persisted.provider_job_id:
+        refuse("DISPATCH_NOT_PRE_SUBMIT",
+               f"job {job_id} in stato {persisted.state.value} "
+               f"(provider_job_id={persisted.provider_job_id!r}): non e' un pre-submit")
+    if persisted.spec_key != spec_key:
+        refuse("DISPATCH_SPEC_MISMATCH", f"job {job_id} appartiene a un'altra spec")
+    if not persisted.operation_id:
+        refuse("DISPATCH_OPERATION_REQUIRED",
+               f"job {job_id} non ha operation_id: nessuna identita' di operazione")
+    if not persisted.attempt_token or persisted.attempt_token != attempt_token:
+        refuse("DISPATCH_ATTEMPT_TOKEN_MISMATCH",
+               f"job {job_id}: attempt_token persistito {persisted.attempt_token!r} != {attempt_token!r}")
+    if not persisted.payload_digest or persisted.payload_digest != payload_digest:
+        refuse("DISPATCH_PAYLOAD_DIGEST_MISMATCH",
+               f"job {job_id}: digest persistito {str(persisted.payload_digest)[:16]}… != "
+               f"{str(payload_digest)[:16]}…")
+    if persisted.provider != adapter_name or (persisted.provider_account or "") != (adapter_account or ""):
+        refuse("DISPATCH_OWNERSHIP_MISMATCH",
+               f"job {job_id} appartiene a {persisted.provider!r}/{persisted.provider_account!r}, "
+               f"adapter {adapter_name!r}/{adapter_account!r}")
+    if not persisted.quote_id:
+        refuse("DISPATCH_QUOTE_REQUIRED",
+               f"job {job_id} non e' legato a una quote fidata: il client non sceglie il prezzo")
+    get_quote = getattr(store, "quote", None)
+    if not callable(get_quote):
+        refuse("DISPATCH_QUOTE_AUTHORITY_MISSING",
+               "lo store non espone l'autorita' della quote (EconomicLedger)")
+    q = get_quote(persisted.quote_id)
+    if q is None:
+        refuse("DISPATCH_QUOTE_UNKNOWN", f"quote {persisted.quote_id} sconosciuta")
+    if q.get("consumed_by") != job_id:
+        refuse("DISPATCH_QUOTE_NOT_CONSUMED_BY_JOB",
+               f"quote {persisted.quote_id} consumata da {q.get('consumed_by')!r}, non da {job_id!r}: "
+               f"l'importo non e' stato impegnato da questo tentativo")
+    if q.get("operation_id") != persisted.operation_id:
+        refuse("DISPATCH_QUOTE_OPERATION_MISMATCH",
+               f"quote {persisted.quote_id} appartiene all'operazione {q.get('operation_id')!r}")
+    if q.get("spec_key") != spec_key:
+        refuse("DISPATCH_QUOTE_SPEC_MISMATCH", f"quote {persisted.quote_id} appartiene a un'altra spec")
+    if not q.get("envelope_id"):
+        refuse("DISPATCH_ENVELOPE_REQUIRED", f"quote {persisted.quote_id} senza envelope")
+    if not _ledger_has_reserve(store, job_id):
+        refuse("DISPATCH_LEDGER_RESERVE_MISSING",
+               f"nessun movimento RESERVE nel ledger per {job_id}: l'envelope non e' impegnato")
+    return DispatchAuthorization(
+        job_id=job_id, spec_key=spec_key, operation_id=persisted.operation_id,
+        attempt_token=attempt_token, payload_digest=payload_digest,
+        provider=adapter_name, provider_account=adapter_account or "",
+        envelope_id=q["envelope_id"], quote_id=persisted.quote_id,
+        quote_amount=int(q["amount"]), quote_unit=str(q["unit"]))
+
+
+class _DispatchGrant:
+    """Concessione a tempo determinato: vive quanto il `with`, e non oltre.
+
+    Non e' rientrante e non e' ereditabile da un altro thread: il dispatch di un
+    tentativo non presta la propria autorizzazione a nessun altro."""
+
+    def __init__(self, adapter, auth: DispatchAuthorization):
+        self._adapter, self._auth = adapter, auth
+
+    def __enter__(self):
+        slot = _grant_slot(self._adapter)
+        if getattr(slot, "auth", None) is not None:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_GRANT_REENTRANT",
+                f"l'adapter {getattr(self._adapter, 'name', '?')!r} ha gia' una concessione "
+                f"attiva in questo thread: un tentativo per volta")
+        slot.auth = self._auth
+        return self._auth
+
+    def __exit__(self, *exc):
+        _grant_slot(self._adapter).auth = None
+        return False
+
+
+_GRANT_LOCK = threading.Lock()
+
+
+def _grant_slot(adapter):
+    """Slot THREAD-LOCAL per istanza di adapter: `Batch.go` dispaccia job in
+    thread paralleli con lo STESSO adapter, e una concessione non deve mai
+    attraversare quel confine."""
+    slot = adapter.__dict__.get("_dispatch_grant_slot")
+    if slot is None:
+        with _GRANT_LOCK:
+            slot = adapter.__dict__.get("_dispatch_grant_slot")
+            if slot is None:
+                slot = threading.local()
+                adapter.__dict__["_dispatch_grant_slot"] = slot
+    return slot
+
+
+def grant_dispatch(adapter, auth: DispatchAuthorization) -> _DispatchGrant:
+    """Unico modo di autorizzare `authorize_payload` + `submit` di uno spender."""
+    return _DispatchGrant(adapter, auth)
+
+
+class SpendCapableAdapter:
+    """Base OBBLIGATORIA per ogni adapter che puo' raggiungere un provider reale.
+
+    Un adapter reale (Higgsfield, o chiunque altro) deriva da qui e implementa
+    `_dispatch(spec, auth)` e `_authorize_payload(digest, auth)`. Non implementa
+    `submit` ne' `authorize_payload`: quei due nomi sono il confine, e
+    `__init_subclass__` rifiuta a tempo di definizione della classe qualunque
+    sottoclasse che provi a ridefinirli o a ereditarli da un'altra base. Non e'
+    una convenzione da ricordare: e' un TypeError."""
+
+    spend_capable = True
+
+    def __init_subclass__(cls, **kwargs):
+        super().__init_subclass__(**kwargs)
+        for name in ("submit", "authorize_payload"):
+            if name in cls.__dict__:
+                raise TypeError(
+                    f"{cls.__qualname__}: `{name}` e' il confine dello spender e non si "
+                    f"sovrascrive; implementare `_dispatch` / `_authorize_payload`")
+            if getattr(cls, name, None) is not getattr(SpendCapableAdapter, name):
+                raise TypeError(
+                    f"{cls.__qualname__}: `{name}` risolve a un'altra implementazione "
+                    f"(ordine di risoluzione: {[b.__name__ for b in cls.__mro__]}); "
+                    f"SpendCapableAdapter deve precedere le altre basi")
+
+    # -------------------------------------------------------- confine
+    def _require_dispatch(self, spec, entry_point: str) -> DispatchAuthorization:
+        auth = getattr(_grant_slot(self), "auth", None)
+        if auth is None:
+            raise SpendAuthorizationRequired(
+                f"{type(self).__qualname__}.{entry_point}",
+                "nessuna concessione attiva in questo thread")
+        if not auth.covers(spec):
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_SPEC_NOT_COVERED",
+                f"{type(self).__qualname__}.{entry_point}: la concessione copre la spec "
+                f"{auth.spec_key[:12]}…, non quella presentata")
+        if getattr(self, "name", None) != auth.provider:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_PROVIDER_NOT_COVERED",
+                f"concessione emessa per {auth.provider!r}, adapter {getattr(self, 'name', None)!r}")
+        return auth
+
+    def authorize_payload(self, digest: str) -> None:
+        auth = self._require_dispatch_digest(digest)
+        return self._authorize_payload(digest, auth)
+
+    def _require_dispatch_digest(self, digest: str) -> DispatchAuthorization:
+        auth = getattr(_grant_slot(self), "auth", None)
+        if auth is None:
+            raise SpendAuthorizationRequired(
+                f"{type(self).__qualname__}.authorize_payload",
+                "nessuna concessione attiva in questo thread")
+        if digest != auth.payload_digest:
+            raise SpendAuthorizationInvalid(
+                "DISPATCH_DIGEST_NOT_COVERED",
+                f"{type(self).__qualname__}.authorize_payload: la concessione copre il digest "
+                f"{auth.payload_digest[:16]}…, non {str(digest)[:16]}…")
+        return auth
+
+    def submit(self, spec: "GenSpec") -> "Job":
+        auth = self._require_dispatch(spec, "submit")
+        return self._dispatch(spec, auth)
+
+    # -------------------------------------------------- da implementare
+    def _authorize_payload(self, digest: str, auth: DispatchAuthorization) -> None:
+        raise NotImplementedError
+
+    def _dispatch(self, spec: "GenSpec", auth: DispatchAuthorization) -> "Job":
+        raise NotImplementedError
+
