+class SpendAuthorizationInvalid(Exception):
+    """Il journal autorevole non autorizza questo dispatch. Fail-closed, parametrico."""
+
+    def __init__(self, code: str, message: str):
+        self.code = code
+        super().__init__(f"{code}: {message}")
