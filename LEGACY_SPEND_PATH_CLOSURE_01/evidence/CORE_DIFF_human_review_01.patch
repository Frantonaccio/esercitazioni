+    e1 = must_raise(SpendAuthorizationRequired, lambda: a._dispatch(s, None))
+    e2 = must_raise(SpendAuthorizationRequired, lambda: a._authorize_payload(digest, None))
+    e3 = must_raise(SpendAuthorizationRequired, lambda: a._dispatch(s, forged))
+    e4 = must_raise(SpendAuthorizationRequired, lambda: a._authorize_payload(digest, forged))
