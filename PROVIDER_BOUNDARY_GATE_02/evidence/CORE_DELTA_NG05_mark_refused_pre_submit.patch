+        settlement zero e' l'azzeramento della riserva. La PROVENANCE e' parametrica e la
+        stessa regola vale: `TRANSPORT_ATTESTED_NOT_SENT` e' riservata al percorso del
+        trasporto e qui e' rifiutata."""
+        if not isinstance(source, str) or not source.strip():
+            raise ReconciliationEvidenceRequired("mark_refused_pre_submit: `source` obbligatoria")
+        if source == "TRANSPORT_ATTESTED_NOT_SENT":
+            raise ReconciliationEvidenceRequired(
+                "mark_refused_pre_submit: provenance del trasporto non ammessa qui")
+        if not isinstance(reason, str) or not reason.strip():
+            raise ReconciliationEvidenceRequired("mark_refused_pre_submit: `reason` obbligatorio")
+        ev = validate_reconciliation_evidence(evidence)
+        if ev["source"] != source:
+            raise ReconciliationEvidenceRequired(
+                f"evidence.source {ev['source']!r} != source {source!r}")
+        if job.provider_job_id:
+            raise TransitionRefused(job.job_id, self._states.get(job.job_id, job.state),
+                                    JobState.FAILED)
+        self._check_write(job, JobState.FAILED, reconciliation=True)
+        full = dict(ev)
+        full.setdefault("reason", reason)
+        self.record_anomaly(job.job_id, "RECONCILIATION",
+                            {"from": JobState.RESERVED.value, "to": JobState.FAILED.value,
+                             "evidence": full}, now)
+        job.state, job.error = JobState.FAILED, reason
+        self._reserved[job.job_id] = 0
+        return self.put(job, _reconciliation=True)
+
